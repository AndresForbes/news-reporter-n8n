    {
      "parameters": {
        "jsCode": "\nconst respuesta = $input.first().json;\n\n// 1. Extraer el texto generado por Gemini.\nconst texto = respuesta.content?.parts?.[0]?.text;\n\nif (typeof texto !== 'string' || !texto.trim()) {\n  throw new Error('Gemini no devolvió texto.');\n}\n\n// 2. Convertir el texto JSON en un objeto.\nlet datos;\n\ntry {\n  datos = JSON.parse(texto.trim());\n} catch (error) {\n  throw new Error('Gemini devolvió un JSON inválido: ' + error.message);\n}\n\n// 3. Comprobar los campos obligatorios.\nif (\n  typeof datos.resumen !== 'string' ||\n  !datos.resumen.trim() ||\n  typeof datos.prompt_imagen !== 'string' ||\n  !datos.prompt_imagen.trim()\n) {\n  throw new Error('Faltan resumen o prompt_imagen en la respuesta.');\n}\n\n// 4. Recuperar los datos originales de la noticia.\nconst noticia = $('Preparar noticia para IA').first().json;\n\n// 5. Devolver un único item con la información completa.\nreturn [\n  {\n    json: {\n      titulo: noticia.titulo,\n      descripcion: noticia.descripcion,\n      enlace: noticia.enlace,\n      fecha: noticia.fecha,\n      fuente: noticia.fuente,\n      resumen: datos.resumen.trim(),\n      prompt_imagen: datos.prompt_imagen.trim()\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1664,
        -16
      ],
      "id": "97a2804f-6546-46ec-b484-43640e012899",
